# Placeholders only. Copy to .env.local and fill in locally. Never commit populated env files.
# Full contract for every environment: docs/planning/IMPLEMENTATION_ROADMAP.md section 4.
# Validated at startup by src/platform/config/env.ts (invalid values stop the server with a readable message).

APP_ENV=local
APP_BASE_URL=http://localhost:3000

# Local Docker Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://itsm:itsm@localhost:5432/itsm_dev
DIRECT_URL=postgresql://itsm:itsm@localhost:5432/itsm_dev

LOG_LEVEL=debug
TRUST_PROXY_HEADERS=0

# --- Used from later phases (optional locally; required when APP_ENV is staging/production) ---
# AUTH_SECRET=            # >= 32 random characters
# AUTH_TRUST_HOST=true
# ENTRA_TENANT_ID=        # GUID
# ENTRA_CLIENT_ID=        # GUID
# ENTRA_CLIENT_SECRET=
# CRON_SECRET=            # >= 32 characters
# STORAGE_PROVIDER=database
# EMAIL_PROVIDER=noop

# --- Directory (Phase 4). Graph daemon app: application permission User.Read.All, admin consent [EXTERNAL] ---
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# DIRECTORY_SYNC_ENABLED=false
# DIRECTORY_ELIGIBILITY_COMPANY_NAME=          # [OPEN] optional exact companyName filter
# DIRECTORY_ELIGIBILITY_EXCLUDE_UPN_PREFIXES=svc-
# AGENTS_VIEW_ALL_TICKETS=false                # [OPEN]

# --- Attachments (Phase 6) ---
# ATTACHMENTS_ENABLED=true                      # false = hide the UI, uploads return 503
# STORAGE_PROVIDER=database                     # database | local (dev only). s3 / azure_blob are NOT implemented yet
# ATTACHMENT_MAX_BYTES=4194304                  # capped at 4 MB with database storage or on Vercel
# STORAGE_LOCAL_DIR=./storage-local             # only for STORAGE_PROVIDER=local
# ATTACHMENT_REQUIRE_CLEAN_SCAN=false           # [OPEN] require scanStatus=clean before download
